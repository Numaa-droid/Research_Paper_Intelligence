# ---------------------------------------------------------------------------
# PaperPilot configuration. Copy to `.env` and fill in. Never commit `.env`.
# All variables are optional; the defaults run fully offline with the mock
# provider, which is what the test-suite uses.
# ---------------------------------------------------------------------------

# --- Model provider -------------------------------------------------------
# "mock" (offline, deterministic) | "openai_compatible" | "huggingface" (local)
PAPERPILOT_LLM_PROVIDER=mock
# For huggingface, a Hub repo id, e.g. ibm-granite/granite-4.1-3b
PAPERPILOT_LLM_MODEL=gpt-4o-mini
# openai_compatible only
PAPERPILOT_LLM_BASE_URL=https://api.openai.com/v1
PAPERPILOT_LLM_API_KEY=
# openai_compatible only: none | low | medium | high. Leave blank to omit.
# Set "none" for thinking models such as qwen3.5 on Ollama.
PAPERPILOT_LLM_REASONING_EFFORT=
# huggingface only: auto | cpu | mps | cuda
PAPERPILOT_LLM_DEVICE=auto
PAPERPILOT_LLM_TEMPERATURE=0.0
# openai_compatible only: fixed sampling seed for repeatable runs. Leave blank to omit.
PAPERPILOT_LLM_SEED=42
PAPERPILOT_LLM_MAX_TOKENS=8192
PAPERPILOT_LLM_MAX_TOKENS_CEILING=16384
PAPERPILOT_LLM_TIMEOUT_SECONDS=90
PAPERPILOT_LLM_MAX_ATTEMPTS=3

# --- Embeddings -----------------------------------------------------------
# "hashing" (offline, deterministic) | "openai_compatible" | "sentence_transformers"
# Docker build only: pip extras baked into the image. Add "embeddings" for
# sentence_transformers.
PAPERPILOT_EXTRAS=postgres
PAPERPILOT_EMBEDDING_PROVIDER=hashing
PAPERPILOT_EMBEDDING_MODEL=text-embedding-3-small
PAPERPILOT_EMBEDDING_BASE_URL=
PAPERPILOT_EMBEDDING_API_KEY=
PAPERPILOT_EMBEDDING_DIM=512

# --- Accounts -------------------------------------------------------------
# Code a new user must enter to create an account. Leave blank only on a
# machine nobody else can reach (anyone could sign up). e.g. `openssl rand -hex 16`
PAPERPILOT_INVITE_CODE=
# Uploads + analysis starts per account per window; 0 disables.
PAPERPILOT_RATE_LIMIT_REQUESTS=60
PAPERPILOT_RATE_LIMIT_WINDOW_SECONDS=3600

# --- Ingestion ------------------------------------------------------------
PAPERPILOT_MAX_UPLOAD_MB=50
# Pages that fail the extraction check (thin, garbled, unmapped glyphs, scanned)
# are read by PaddleOCR-VL-1.6 GGUF served by llama-server (`make ocr-server`).
PAPERPILOT_OCR_ENABLED=true
PAPERPILOT_OCR_MIN_CHARS_PER_PAGE=180
PAPERPILOT_OCR_BASE_URL=http://127.0.0.1:8080/v1
PAPERPILOT_OCR_MODEL=PaddleOCR-VL-1.6
PAPERPILOT_OCR_TIMEOUT_SECONDS=300
# also read charts and diagrams on text pages (text still comes from PyMuPDF)
PAPERPILOT_OCR_FIGURES_ENABLED=true
# re-read tables to recover headers and cell order (used only when it matches the text layer)
PAPERPILOT_OCR_TABLES_ENABLED=true

# --- Layout analysis (optional: pip install -e ".[layout]") -----------------
# Run PP-Structure over every page and re-cut the text blocks along the regions
# it finds, instead of inferring the structure from how the text is set. Costs a
# rasterise + a model pass per page, so it is off by default.
PAPERPILOT_LAYOUT_ENABLED=false
PAPERPILOT_LAYOUT_ENGINE=pp_structure
# Pinned: a different model finds different regions, changing the parse.
PAPERPILOT_LAYOUT_MODEL=PP-DocLayout_plus-L
PAPERPILOT_LAYOUT_LANG=en
# Detections are computed in pixels, so the DPI is part of the result.
PAPERPILOT_LAYOUT_DPI=200
PAPERPILOT_LAYOUT_MIN_SCORE=0.5
# "cpu" keeps inference reproducible; GPU reduction order is not stable.
PAPERPILOT_LAYOUT_DEVICE=cpu
# Analysed pages are cached by page image + engine configuration. Empty disables
# the cache; the regions are the same either way.
PAPERPILOT_LAYOUT_CACHE_DIR=data/layout_cache

PAPERPILOT_CHUNK_MAX_CHARS=1200
PAPERPILOT_CHUNK_OVERLAP_CHARS=150

# --- Retrieval ------------------------------------------------------------
PAPERPILOT_RETRIEVAL_TOP_K=8
PAPERPILOT_RERANK_ENABLED=false

# --- Orchestration --------------------------------------------------------
PAPERPILOT_MAX_RETRIES=1
PAPERPILOT_VERIFICATION_THRESHOLD=0.85
PAPERPILOT_PARALLEL_AGENTS=true
PAPERPILOT_MATH_MIN_EQUATIONS=3
# Read every content chunk no specialist was shown, in at most this many extra calls
PAPERPILOT_COVERAGE_ENABLED=true
PAPERPILOT_COVERAGE_MAX_BATCHES=4

# --- Storage --------------------------------------------------------------
PAPERPILOT_DATA_DIR=./data
# A local SQLite file, or PostgreSQL such as Supabase (needs: pip install -e ".[postgres]").
# Supabase: Project → Connect → "Session pooler" string, with your database password:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
PAPERPILOT_DATABASE_URL=sqlite:///./data/paperpilot.sqlite
# PostgreSQL only: schema for PaperMind's tables (kept out of Supabase's public Data API).
PAPERPILOT_DATABASE_SCHEMA=paperpilot
# Docker only: the database the container uses (defaults to SQLite on the volume).
# PAPERPILOT_DOCKER_DATABASE_URL=postgresql://...

# --- Observability --------------------------------------------------------
PAPERPILOT_LOG_LEVEL=INFO
# "auto": readable lines in a terminal, JSON when piped | "pretty" | "json" | "text"
PAPERPILOT_LOG_FORMAT=auto
# HTTP request lines: "changes" hides successful GET polling | "errors" | "all" | "none"
PAPERPILOT_LOG_HTTP=changes
PAPERPILOT_LOG_DOCUMENT_TEXT=false

# --- Tracing (self-hosted run inspector at /tracing) -----------------------
# Record every run as a tree of spans: graph nodes, agents, retrievals, model calls.
PAPERPILOT_TRACING_ENABLED=true
# Keep prompts, model answers and retrieved passages in traces (false: sizes only).
PAPERPILOT_TRACING_CAPTURE_CONTENT=true
# Most recent traces kept in data/traces.sqlite; 0 keeps all.
PAPERPILOT_TRACING_RETENTION=200
